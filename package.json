{
  "name": "enker",
  "version": "0.1.0",
  "description": "Crash safe workflow steps for Node.js and TypeScript, backed by SQLite. Resume after crashes, retry, sleep, and replay failed runs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "enker": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "workflow",
    "durable-execution",
    "sqlite",
    "retry",
    "idempotency",
    "crash-recovery"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enmilo-dev/enker.git"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "enker": "tsx src/cli.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "author": "Md Raihan Ahmed",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
